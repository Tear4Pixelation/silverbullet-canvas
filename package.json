{
  "name": "silverbullet-canvas",
  "version": "0.2.0",
  "private": true,
  "description": "Lightweight JSON Canvas (.canvas) editor plug for SilverBullet",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:editor": "node build.mjs",
    "build:plug": "plug-compile canvas.plug.yaml",
    "build": "npm run build:editor && npm run build:plug",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@silverbulletmd/silverbullet": "^2.12.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1"
  }
}
